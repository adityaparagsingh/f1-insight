# F1 INSIGHT — environment configuration
# Copy this file to `.env` and adjust values. Never commit real credentials.

# --- Database (MySQL data warehouse) ---
DATABASE_URL=mysql+pymysql://f1user:f1pass@127.0.0.1:3306/f1_insight

# --- Jolpica (Ergast-compatible) Formula 1 API ---
JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1
JOLPICA_TIMEOUT=30
JOLPICA_MAX_RETRIES=5
JOLPICA_REQUESTS_PER_SECOND=8

# --- ETL ---
ETL_CACHE_DIR=./etl/cache
ETL_LOG_DIR=./logs

# --- Backend ---
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://127.0.0.1:8000/api
